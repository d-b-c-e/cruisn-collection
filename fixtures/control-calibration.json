{
  "version": 1,
  "raw_domain": [-1.0, 1.0],
  "absolute_tolerance": 1e-12,
  "contract": "steering [-1,1], pedal [0,1]; null calibration is unchanged raw input; endpoints then inversion then one zero deadzone; clamp to captured endpoints",

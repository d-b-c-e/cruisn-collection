    {"name":"steering_symmetric", "calibration":{"version":1,"kind":"steering","left":-1,"centre":0,"right":1,"invert":false,"deadzone":0},
     "samples":[[-1,-1],[-0.5,-0.5],[0,0],[0.5,0.5],[1,1]]},
    {"name":"steering_asymmetric_offcentre", "calibration":{"version":1,"kind":"steering","left":-0.8,"centre":0.2,"right":1,"invert":false,"deadzone":0},
     "samples":[[-1,-1],[-0.8,-1],[-0.3,-0.5],[0.2,0],[0.6,0.5],[1,1]]},
    {"name":"steering_reversed_raw_orientation", "calibration":{"version":1,"kind":"steering","left":0.9,"centre":0.1,"right":-0.7,"invert":false,"deadzone":0},
     "samples":[[1,-1],[0.9,-1],[0.5,-0.5],[0.1,0],[-0.3,0.5],[-0.7,1],[-1,1]]},
    {"name":"steering_inverted_deadzone_once", "calibration":{"version":1,"kind":"steering","left":-0.8,"centre":0,"right":0.8,"invert":true,"deadzone":0.2},
     "samples":[[-1,1],[-0.8,1],[-0.48,0.5],[-0.16,0],[0,0],[0.16,0],[0.48,-0.5],[0.8,-1],[1,-1]]},
    {"name":"pedal_end_rest_low", "calibration":{"version":1,"kind":"pedal","released":-1,"full":1,"invert":false,"deadzone":0},
     "samples":[[-1,0],[-0.5,0.25],[0,0.5],[0.5,0.75],[1,1]]},
    {"name":"pedal_centre_rest", "calibration":{"version":1,"kind":"pedal","released":0,"full":1,"invert":false,"deadzone":0},
     "samples":[[-1,0],[0,0],[0.25,0.25],[0.5,0.5],[1,1]]},
    {"name":"pedal_high_rest_reversed", "calibration":{"version":1,"kind":"pedal","released":1,"full":-1,"invert":false,"deadzone":0},
     "samples":[[1,0],[0.5,0.25],[0,0.5],[-0.5,0.75],[-1,1]]},
    {"name":"pedal_partial_range_deadzone_once", "calibration":{"version":1,"kind":"pedal","released":-0.4,"full":0.8,"invert":false,"deadzone":0.1},
     "samples":[[-1,0],[-0.4,0],[-0.28,0],[0.26,0.5],[0.8,1],[1,1]]},
    {"name":"pedal_explicit_inversion_then_deadzone", "calibration":{"version":1,"kind":"pedal","released":-1,"full":1,"invert":true,"deadzone":0.2},
     "samples":[[-1,1],[-0.2,0.5],[0.6,0],[1,0]]}
  ]
}

+
+		bool const f9 = (GetAsyncKeyState(VK_F9) & 0x8000) != 0;
+		if (f9 && !f9_prev)
+			crt = !crt;
+		f9_prev = f9;
+		{
+			bool const fg = (GetForegroundWindow() == parent);
+			auto edge = [&](int vk, bool &prev) -> bool
+			{
+				bool const down = fg && (GetAsyncKeyState(vk) & 0x8000) != 0;
+				bool const e = down && !prev;
+				prev = down;
+				return e;
+			};

+// TMS320C3x 32-bit float -> host float: [exp 8b two's-comp][sign][frac 23b]
+static float c3x_to_float(uint32_t w)
+{
+	int e = (w >> 24) & 0xff;
+	int s = (w >> 23) & 1;

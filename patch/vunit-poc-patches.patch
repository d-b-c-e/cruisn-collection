+							bypc[uint32_t(kv.first >> 24)] += kv.second;
+						for (auto &kv : bypc)
+							fprintf(f, "pc %05x  n %llu\n", kv.first, (unsigned long long)kv.second);
+						fprintf(f, "--- pc/addr pairs (first 64) ---\n");
+						int n = 0;
+						for (auto &kv : rt_counts)

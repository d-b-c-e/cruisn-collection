 		bool const textured = (dma[0] & 0x300) == 0x100;
 		// dither bit0; bit1 flags backdrop (sky/horizon band) so the shader
@@ -880,6 +888,7 @@ static void build_vertices(const std::vector<QuadMsg> &quads, float xoff,

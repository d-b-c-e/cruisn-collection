From 72c9e6feedefa416ee117ed6891eb2a6bd703e87 Mon Sep 17 00:00:00 2001
From: d-b-c-e <anthony.mason1@gmail.com>
Date: Thu, 3 Sep 2026 10:52:16 -0500
Subject: [PATCH 75/88] MIDV_FFB_SLEW - cap the wheel-motor force change per
 game update (V-Unit + Exotica)

The FFB Arcade Plugin applies every game update instantly (one constant
force re-levelled per update, plus a rumble burst) and ignores zero, so
the games' instant reversals reach a strong wheel as slams. A slew cap
of N (of 127) per update turns a kick into a swell without adding lag to
small changes; applied before MIDV_FFB_CLAMP. Verified headless: slew 12
-> max step 12, a 63-kick becomes 12,24,36,48,60 then the decay. Inert
unset.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/mame/midway/midvunit.cpp | 24 +++++++++++++++++++-----
 src/mame/midway/midzeus.cpp  | 12 ++++++++++++
 2 files changed, 31 insertions(+), 5 deletions(-)

diff --git a/src/mame/midway/midvunit.cpp b/src/mame/midway/midvunit.cpp
index a5d5e018..d619a2ae 100644
--- a/src/mame/midway/midvunit.cpp
+++ b/src/mame/midway/midvunit.cpp
@@ -589,13 +589,27 @@ void midvunit_state::wheel_board_w(uint32_t data)
 							if (s_clamp < 0 || s_clamp > 127)
 								s_clamp = 0;
 						}
-						uint8_t out = arg;
-						if (s_clamp > 0)
+						// MIDV_FFB_SLEW=N (of 127): cap how far the force may move per
+						// game update. The games' kicks reverse instantly and the
+						// plugin applies them instantly (a constant force + a rumble
+						// burst per update); a slew cap turns the slam into a swell
+						// without adding lag to small changes. 0 = off.
+						static int s_slew = -1;
+						static int s_prev = 0;
+						if (s_slew < 0)
 						{
-							int const f = int8_t(arg);
-							out = uint8_t(int8_t(std::clamp(f, -s_clamp, s_clamp)));
+							const char *e = std::getenv("MIDV_FFB_SLEW");
+							s_slew = e ? atoi(e) : 0;
+							if (s_slew < 0 || s_slew > 127)
+								s_slew = 0;
 						}
-						m_wheel_motor = out;
+						int f = int(int8_t(arg));
+						if (s_slew > 0)
+							f = s_prev + std::clamp(f - s_prev, -s_slew, s_slew);
+						if (s_clamp > 0)
+							f = std::clamp(f, -s_clamp, s_clamp);
+						s_prev = f;
+						m_wheel_motor = uint8_t(int8_t(f));
 					}
 					//LOGINPUT("Wheel board (U4 74HC574; Motor) = %02X\n", arg);
 					break;
diff --git a/src/mame/midway/midzeus.cpp b/src/mame/midway/midzeus.cpp
index eb5c2c45..da63df49 100644
--- a/src/mame/midway/midzeus.cpp
+++ b/src/mame/midway/midzeus.cpp
@@ -726,11 +726,23 @@ void crusnexo_state::crusnexo_leds_w(offs_t offset, uint32_t data)
 				if (s_gain < 25 || s_gain > 800)
 					s_gain = 100;
 			}
+			static int s_slew = -1;   // MIDV_FFB_SLEW: see midvunit.cpp
+			static int s_prev = 0;
+			if (s_slew < 0)
+			{
+				const char *e = std::getenv("MIDV_FFB_SLEW");
+				s_slew = e ? atoi(e) : 0;
+				if (s_slew < 0 || s_slew > 127)
+					s_slew = 0;
+			}
 			int f = int(int8_t(data & 0xff));
 			if (s_gain != 100)
 				f = std::clamp((f * s_gain) / 100, -127, 127);
+			if (s_slew > 0)
+				f = s_prev + std::clamp(f - s_prev, -s_slew, s_slew);
 			if (s_clamp > 0)
 				f = std::clamp(f, -s_clamp, s_clamp);
+			s_prev = f;
 			m_wheel_motor = uint8_t(int8_t(f));
 			break;
 		}

+	gl.BindBuffer(ARRAY_BUFFER, vbo_u);
+	{
+		int loc = gl.GetAttribLocation(prog, "in_meta");
+		gl.EnableVertexAttribArray(loc);
+		gl.VertexAttribIPointer(loc, 4, 0x1405 /*UNSIGNED_INT*/, 16, nullptr);
+	}

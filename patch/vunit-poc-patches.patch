From 93acdd2bb8c8a7953702e213c6a930763ad1659f Mon Sep 17 00:00:00 2001
From: d-b-c-e <anthony.mason1@gmail.com>
Date: Fri, 21 Aug 2026 01:22:35 -0500
Subject: [PATCH 23/38] GL overlay: persist live CRT toggle state for the
 launcher

F9 and the Esc-menu CRT toggle flip the pass live, but the collection
shell's saved setting never learned - the SETTINGS row and the next
launch drifted from what the player last saw. At teardown the overlay now
writes crt=0/1 to MIDV_GL_STATEFILE; the shell reads it back.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01QABHMhAzD8GxaNT8zBVLho
---
 src/mame/midway/midvunit_v.cpp | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/src/mame/midway/midvunit_v.cpp b/src/mame/midway/midvunit_v.cpp
index 95d0e3ea..39290867 100644
--- a/src/mame/midway/midvunit_v.cpp
+++ b/src/mame/midway/midvunit_v.cpp
@@ -1099,6 +1099,18 @@ void thread_main()
 		}
 		SwapBuffers(dc);
 	}
+	// persist live-toggle state (F9 / Esc-menu CRT) for the launcher: the
+	// collection shell reads this back so its SETTINGS row and the next
+	// launch match what the player last saw on screen
+	if (char const *sf = std::getenv("MIDV_GL_STATEFILE"))
+	{
+		FILE *f = fopen(sf, "w");
+		if (f)
+		{
+			fprintf(f, "crt=%d\n", crt ? 1 : 0);
+			fclose(f);
+		}
+	}
 	logf("%s after %llu presents, %d snaps",
 		s_stop.load() ? "machine exit" : "parent gone",
 		(unsigned long long)presents, snap_n);

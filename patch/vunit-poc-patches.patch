+// (0.5 + 0.001 tie guard) reproduces that span exactly - adjacent tiles
+// then partition the fine pixels with no gap and no overlap.
+static void dilate_rect(float *vx, float *vy, const int16_t *ix, const int16_t *iy)
+{

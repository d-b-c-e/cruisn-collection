From 6f55ed93ce5df76f01007096657cfd2491000ad0 Mon Sep 17 00:00:00 2001
From: d-b-c-e <anthony.mason1@gmail.com>
Date: Sat, 28 Mar 2026 20:27:47 -0500
Subject: [PATCH 01/38] dinput joystick: use DIJOYSTATE2 for 128-button support
 Use c_dfDIJoystick2 as the primary data format for DirectInput joystick
 devices, with c_dfDIJoystick as a fallback. This raises the button limit from
 32 (DIJOYSTATE) to 128 (DIJOYSTATE2). The existing code already handles up to
 128 buttons in configure() - it assigns ITEM_ID_BUTTON1-32 for the first 32,
 ADD_SWITCH for 33-48, and OTHER_SWITCH for 49+. The mouse device already uses
 this same format1/format2 fallback pattern (c_dfDIMouse2 with c_dfDIMouse).
 Changes: - input_dinput.h: DIJOYSTATE -> DIJOYSTATE2 in dinput_joystick_state
 - input_dinput.cpp: Request c_dfDIJoystick2 with c_dfDIJoystick fallback -
 input_dinput.cpp: Cap dwButtons based on accepted format (32 or 128)   to
 prevent buffer overread when fallback format is used This benefits racing
 wheels (Moza, Fanatec), HOTAS throttles (Virpil, VKB), and button boxes that
 expose more than 32 buttons via DirectInput.

---
 src/osd/modules/input/input_dinput.cpp | 4 ++--
 src/osd/modules/input/input_dinput.h   | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/osd/modules/input/input_dinput.cpp b/src/osd/modules/input/input_dinput.cpp
index 900aa4b8..d7aa31ca 100644
--- a/src/osd/modules/input/input_dinput.cpp
+++ b/src/osd/modules/input/input_dinput.cpp
@@ -452,8 +452,8 @@ protected:
 		auto devinfo = m_dinput_helper->create_device<dinput_joystick_device>(
 				*this,
 				instance,
+				&c_dfDIJoystick2,
 				&c_dfDIJoystick,
-				nullptr,
 				background_input() ? dinput_cooperative_level::BACKGROUND : dinput_cooperative_level::FOREGROUND,
 				[] (auto const &device, auto const &format) -> bool
 				{
@@ -560,7 +560,7 @@ dinput_joystick_device::dinput_joystick_device(
 	// cap the number of axes, POVs, and buttons based on the format
 	m_caps.dwAxes = std::min(m_caps.dwAxes, DWORD(8));
 	m_caps.dwPOVs = std::min(m_caps.dwPOVs, DWORD(4));
-	m_caps.dwButtons = std::min(m_caps.dwButtons, DWORD(128));
+	m_caps.dwButtons = std::min(m_caps.dwButtons, DWORD((m_format == &c_dfDIJoystick) ? 32 : 128));
 }
 
 void dinput_joystick_device::reset()
diff --git a/src/osd/modules/input/input_dinput.h b/src/osd/modules/input/input_dinput.h
index 98fdfb01..c01403ee 100644
--- a/src/osd/modules/input/input_dinput.h
+++ b/src/osd/modules/input/input_dinput.h
@@ -174,7 +174,7 @@ private:
 	// state information for a joystick; DirectInput state must be first element
 	struct dinput_joystick_state
 	{
-		DIJOYSTATE  state;
+		DIJOYSTATE2 state;
 		LONG        rangemin[8];
 		LONG        rangemax[8];
 	};
-- 

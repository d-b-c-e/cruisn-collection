From 93bac9db22eda14bef465c25366eef212274f1b0 Mon Sep 17 00:00:00 2001
From: d-b-c-e <anthony.mason1@gmail.com>
Date: Wed, 2 Sep 2026 20:38:11 -0500
Subject: [PATCH 070/124] midvunit: MIDV_FFB_CLAMP - cap the wheel-motor force
 byte (env-gated)

Measured headless (wheel sweep under the force trace): the V-Unit games'
force is a kick opposite to and proportional to each wheel movement,
gone within ~100 ms - a damper, not a spring (steps of 32/64/112 counts
-> peaks 30/63/100 of 127). On a strong direct-drive base that loop is
unstable (wheel slams left-right by itself, tester video). Clamping the
signed byte at +-N on the WHLCTLZ write caps the kicks while small road
forces keep full strength; inert unset.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/mame/midway/midvunit.cpp | 27 ++++++++++++++++++++++++++-
 1 file changed, 26 insertions(+), 1 deletion(-)

diff --git a/src/mame/midway/midvunit.cpp b/src/mame/midway/midvunit.cpp
index c6841984880..a5d5e0186ac 100644
--- a/src/mame/midway/midvunit.cpp
+++ b/src/mame/midway/midvunit.cpp
@@ -23,6 +23,8 @@
 **************************************************************************/
 
 #include "emu.h"
+
+#include <algorithm>
 #include "midvunit.h"
 
 #include "cpu/adsp2100/adsp2100.h"
@@ -571,7 +573,30 @@ void midvunit_state::wheel_board_w(uint32_t data)
 					LOGINPUT("Wheel board (ATODRDZ) = %02X\n", arg);
 					break;
 				case 4: // WHLCTLZ
-					m_wheel_motor = arg;
+					// POC (env-gated, inert unset): MIDV_FFB_CLAMP=N caps the
+					// signed force byte at +-N. The game's force is a kick
+					// opposite to and proportional to each wheel movement (a
+					// damper, measured: steps of 32/64/112 counts -> peaks of
+					// 30/63/100), which turns into a violent limit cycle on a
+					// strong direct-drive base; capping the peaks stabilises
+					// the loop while small road forces keep full strength.
+					{
+						static int s_clamp = -1;
+						if (s_clamp < 0)
+						{
+							const char *e = std::getenv("MIDV_FFB_CLAMP");
+							s_clamp = e ? atoi(e) : 0;
+							if (s_clamp < 0 || s_clamp > 127)
+								s_clamp = 0;
+						}
+						uint8_t out = arg;
+						if (s_clamp > 0)
+						{
+							int const f = int8_t(arg);
+							out = uint8_t(int8_t(std::clamp(f, -s_clamp, s_clamp)));
+						}
+						m_wheel_motor = out;
+					}
 					//LOGINPUT("Wheel board (U4 74HC574; Motor) = %02X\n", arg);
 					break;
 				case 5: // DRVCTLZ

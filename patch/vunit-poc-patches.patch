+	"    float cornerd = length(max(cc - vec2(0.94), 0.0)) / 0.06;\n"
+	"    float cornerm = 1.0 - smoothstep(0.8, 1.0, cornerd);\n"
+	"    float vig = 1.0 - 0.10 * dot(cc, cc);\n"
+	"\n"
+	"    rgb *= scan * cornerm * vig * 1.42;\n"
+	"    color = vec4(min(rgb * mask, 1.0), 1.0);\n"
+	"}\n"
+	"\n";
 

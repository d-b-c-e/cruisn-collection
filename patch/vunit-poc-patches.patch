+	uint texram = make_tex(4096, 2048, R8UI);
+	uint paltex = make_tex(256, 128, R32UI);
+	uint pageTex[2] = { make_tex(fw, fh, R16UI), make_tex(fw, fh, R16UI) };
+	uint underTex[2] = { make_tex(512, HEIGHT, R16UI), make_tex(512, HEIGHT, R16UI) };

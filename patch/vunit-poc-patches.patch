+		uint64_t r = s_rr.load(std::memory_order_relaxed);
+		auto ring_get = [&](void *dst, uint32_t n)
+		{
+			uint32_t const o = uint32_t(r % RING);
+			uint32_t const first = std::min(n, uint32_t(RING - o));
+			memcpy(dst, s_ringbuf + o, first);

From ed208255c50c8ad457f1c3efb11671fe1c394e35 Mon Sep 17 00:00:00 2001
From: d-b-c-e <anthony.mason1@gmail.com>
Date: Sat, 22 Aug 2026 20:56:16 -0500
Subject: [PATCH 30/38] midvunit: in-memory code patcher (MIDV_PATCH) + runtime
 16:9 margin

Code patcher: the TMS320C31 program is copied maindata ROM -> program RAM
at reset; midv_apply_patches overlays word patches on that RAM copy, so
ROM files are never modified. MIDV_PATCH=<file>, "WORDADDR OLD NEW" hex,
OLD verified (or * to skip). Foundation for game-code fixes; verified
end-to-end.

Runtime margin: MARGIN is now MIDV_GL_MARGIN (0..86/side, default 86).
Lets a game trim its outer widescreen margin where a backdrop/water plane
is legitimately drawn but reads as a corner artifact (offroadc canyon
water) - the ground geometry there already extends to x=-366..1000, so it
is revealed backdrop, not a cull limit or a fillable hole.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01QABHMhAzD8GxaNT8zBVLho
---
 src/mame/midway/midvunit.cpp   | 54 ++++++++++++++++++++++++++++++++++
 src/mame/midway/midvunit_v.cpp | 10 ++++++-
 2 files changed, 63 insertions(+), 1 deletion(-)

diff --git a/src/mame/midway/midvunit.cpp b/src/mame/midway/midvunit.cpp
index a04d7879..8e66c38b 100644
--- a/src/mame/midway/midvunit.cpp
+++ b/src/mame/midway/midvunit.cpp
@@ -106,12 +106,66 @@ void midvplus_state::machine_start()
 }
 
 
+// ── POC code patcher (env-gated, ROM files untouched) ───────────────────
+// The whole TMS320C31 program is copied maindata ROM -> program RAM at each
+// reset; we overlay word patches on that RAM copy, so nothing on disk is
+// modified (GPL/legal bright line intact). MIDV_PATCH=<file>, one patch per
+// line: "WORDADDR OLD NEW" in hex (WORDADDR is a program-RAM word index
+// 0..0x1ffff; OLD is verified before writing, or "*" to skip the check).
+// Lines starting with # are comments. Used for the ground-culling widen
+// experiment - see cruisn-collection results/RESULTS.md.
+static void midv_apply_patches(uint32_t *ram)
+{
+	const char *path = std::getenv("MIDV_PATCH");
+	if (!path)
+		return;
+	FILE *f = fopen(path, "r");
+	if (!f)
+		return;
+	char line[256];
+	int applied = 0, skipped = 0;
+	while (fgets(line, sizeof(line), f))
+	{
+		if (line[0] == '#' || line[0] == '\n')
+			continue;
+		char oldtok[64] = {};
+		unsigned addr = 0, newval = 0;
+		if (sscanf(line, "%x %63s %x", &addr, oldtok, &newval) != 3)
+			continue;
+		if (addr >= 0x20000)
+			continue;
+		if (strcmp(oldtok, "*") != 0)
+		{
+			unsigned oldval = strtoul(oldtok, nullptr, 16);
+			if (ram[addr] != oldval)
+			{
+				skipped++;
+				continue;   // guard: game version / address mismatch
+			}
+		}
+		ram[addr] = newval;
+		applied++;
+	}
+	fclose(f);
+	if (std::getenv("MIDV_GL_LOG"))
+	{
+		FILE *lg = fopen("midv_gl.log", "a");
+		if (lg)
+		{
+			fprintf(lg, "MIDV_PATCH %s: %d applied, %d skipped\n",
+				path, applied, skipped);
+			fclose(lg);
+		}
+	}
+}
+
 void midvunit_base_state::machine_reset()
 {
 	m_dcs->reset_w(0);
 	m_dcs->reset_w(1);
 
 	memcpy(m_ram_base, memregion("maindata")->base(), 0x20000*4);
+	midv_apply_patches(m_ram_base);
 	m_maincpu->reset();
 }
 

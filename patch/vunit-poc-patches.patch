index ab58bbd9..172d94e1 100644
--- a/src/mame/midway/midvunit_v.cpp
+++ b/src/mame/midway/midvunit_v.cpp
@@ -1731,6 +1731,7 @@ static int s_strength = 100;
 static bool s_invert = false;

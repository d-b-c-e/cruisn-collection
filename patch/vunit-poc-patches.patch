 	gl.Uniform1i(uCrt, crt ? 1 : 0);
 	gl.Uniform1f(uSrcH, float(H));
+	gl.Uniform1i(gl.GetUniformLocation(pal, "maskTex"), 3);
 	bool f9_prev = false;
 

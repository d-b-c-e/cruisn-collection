+			SetCursor(nullptr);   // no arrow over the game
+			return TRUE;
+		case WM_LBUTTONDOWN:
+		case WM_RBUTTONDOWN:
+		case WM_MBUTTONDOWN:
+			// we never activate; hand the click to MAME's window instead
+			SetForegroundWindow(GetWindow(hwnd, GW_OWNER));

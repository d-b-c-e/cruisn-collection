From: d-b-c-e <anthony.mason1@gmail.com>
Date: Wed, 9 Sep 2026 09:00:43 -0500
Subject: [PATCH 138/181] Drain requested diagnostic captures before machine
 teardown

---
 src/mame/midway/midvunit_v.cpp | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/src/mame/midway/midvunit_v.cpp b/src/mame/midway/midvunit_v.cpp
index 50be50914ee..b5cb63f3031 100644
--- a/src/mame/midway/midvunit_v.cpp
+++ b/src/mame/midway/midvunit_v.cpp
@@ -602,6 +602,8 @@ namespace mvgl {
 // its acknowledgement (see midvunit_base_state::mvgl_exit)
 static std::atomic<bool> s_stop{false};
 static std::atomic<bool> s_done{false};
+// Updated only after the completed scene, optional BMP and swap have finished.
+static std::atomic<uint32_t> s_presented_frame{0};
 // Esc-menu pause request: set by the GL thread, acted on by the emu
 // thread in screen_update (pause/resume are not thread-safe from here)
 static std::atomic<int> s_menu_pause{0};
@@ -1775,6 +1777,7 @@ void thread_main()
 			}
 		}
 		SwapBuffers(dc);
+		if(frame_complete)s_presented_frame.store(completed_frame);
 	}
 	// persist live-toggle state (F9 / Esc-menu CRT) for the launcher: the
 	// collection shell reads this back so its SETTINGS row and the next
@@ -2689,6 +2692,24 @@ void midv_telemetry_start(running_machine &machine)
 
 void midvunit_base_state::mvgl_exit()
 {
+	// Diagnostic capture can lag the producer while writing large 4K BMPs.
+	// Keep the machine/resources alive while its already-queued frames drain;
+	// no additional guest frame or physical output is generated by this wait.
+	// Normal player exits keep their existing path and response time.
+	if(const char *drain=std::getenv("MIDV_GL_DRAIN_FRAME"))
+		if(std::getenv("MIDV_FFB") && !strcmp(std::getenv("MIDV_FFB"),"0"))
+		{
+			char *end=nullptr;const auto target=strtoul(drain,&end,10);
+			if(*drain && !*end && *drain!='-' && target<=1000000)
+			{
+				const auto began=GetTickCount64();
+				while(!mvgl::s_done.load() && mvgl::s_presented_frame.load()<target &&
+					GetTickCount64()-began<10000)Sleep(5);
+				osd_printf_info("MIDV capture drain: target=%lu presented=%u wait_ms=%llu complete=%u\n",
+					target,mvgl::s_presented_frame.load(),(unsigned long long)(GetTickCount64()-began),
+					unsigned(mvgl::s_presented_frame.load()>=target));
+			}
+		}
 	// POC: a detached GL thread that outlives the machine races teardown
 	// (msvcrt!memcpy AVs logged at roughly every second exit). Flag it down
 	// and give it up to a second to acknowledge before destruction proceeds.

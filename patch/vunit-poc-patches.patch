 {
 	memcpy(m_ram_base, memregion("maindata")->base(), 0x40000*4);
 	*m_ram_base <<= 1;
+	midz_apply_patches(m_ram_base);
 	m_maincpu->reset();
 
 	m_cmos_protected = true;

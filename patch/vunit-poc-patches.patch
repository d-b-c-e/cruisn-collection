+	gl.GenFramebuffers(2, fbo);
+	for (int i = 0; i < 2; i++)
+	{
+		gl.BindFramebuffer(FRAMEBUFFER, fbo[i]);
+		gl.FramebufferTexture2D(FRAMEBUFFER, COLOR_ATTACHMENT0, 0x0DE1, pageTex[i], 0);
+		if (gl.CheckFramebufferStatus(FRAMEBUFFER) != FRAMEBUFFER_COMPLETE)

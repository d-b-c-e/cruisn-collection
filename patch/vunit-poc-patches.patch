+		static uint64_t rt_total = 0;
+		std::string path_copy(rt_path);
+		auto tap = [this, path_copy](offs_t offset, u32 &data, u32 mem_mask)
+		{
+			if ((data >> 24) == 0x24)
+			{
+				rt_counts[(uint64_t(m_maincpu->pcbase()) << 24) | (offset & 0xffffff)]++;

+static const char *MVGL_PAL_VS = R"GLSL(
+#version 430
+out vec2 uv;
+void main() {  // full-screen triangle
+    vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
+    uv = p;

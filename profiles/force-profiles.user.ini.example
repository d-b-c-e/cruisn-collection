# =============================================================================
# YOUR OWN FORCE-FEEDBACK TUNE  -  Cruis'n Collection
# =============================================================================
#
# TO USE THIS FILE: rename it to
#
#     force-profiles.user.ini
#
# (drop the ".example"), then pick MY TUNE (50) in
# SETTINGS > FORCE FEEDBACK > FEEL and launch a game.
#
# While it still ends in .example nothing reads it, so you can leave it here
# untouched forever. Once renamed it is YOURS: updating the collection never
# overwrites force-profiles.user.ini, and your sections beat the shipped ones.
# (The shipped file next to it, force-profiles.ini, IS replaced on every
# update - so edit this one, not that one.)
#
#
# HOW TO TUNE WITHOUT GUESSING
# -----------------------------------------------------------------------------
#   1. Change ONE value.
#   2. Launch, drive the same stretch of road you always use.
#   3. Keep it or put it back.
# Two changes at once and you will not know which one did it.
#
# Every number below is already set to what STANDARD uses, so before you touch
# anything this tune drives exactly like the default. That is deliberate: your
# first edit is then the only difference between them.
#
#
# WHAT CRUIS'N ACTUALLY USES
# -----------------------------------------------------------------------------
# These games are unusual. The arcade board did its own force calculation and
# handed the cabinet a finished number, many times a second. There is no car
# physics for us to model - so every `model.*` setting you may see in the
# shipped profiles does NOTHING here, and none of them appear below. What you
# are tuning is how that finished force is DELIVERED to your wheel.
#
# Three things are NOT in this file because they are effects your wheel base
# produces itself rather than shaping of the game's force. They live in
# rig\collection.ini under [collection]:
#
#   ffb_spring_<game>   the centring pull that stops the wheel feeling floppy
#                       (on by default at 72 for USA, World and Off Road)
#   ffb_rumble          a short vibration on every force change
#   ffb_damper          resistance proportional to how fast you turn
#   ffb_friction        constant drag
#
# If your wheel still shakes with smoothing at its highest, the cause is one of
# those, not anything in here.
#
# =============================================================================


[cruisn-vunit@50]
description = my tune

# Start from the shipped default and change only what you list below. Swap this
# for cruisn-vunit@3 to start from RAW, or @4 to start from CALM.
inherits = cruisn-vunit@1


# --- the one that changes the most --------------------------------------------
#
# How long the force takes to follow the game, in milliseconds. This is the
# single dial the four shipped tunes differ by, and the first thing to try.
#
#   0    RAW       nothing is smoothed. Every kick arrives instantly and intact.
#                  The most detailed and the most alive - and on a strong
#                  direct-drive wheel the most likely to start hunting
#                  left-right on its own, because these games push back against
#                  every movement you make and keep pushing for about a sixth of
#                  a second after you stop.
#   20   CRISP     takes the edge off the fastest twitches, keeps the detail.
#   50   STANDARD  the default.
#   80   CALM      heavily rounded. A wheel that will not settle usually settles
#                  here. On a lighter wheel it will just feel vague and late.
#
# Higher = calmer but later and duller. Lower = sharper and more informative but
# noisier. Anything between these numbers is fair game: 35, 65, whatever.
shaper.smoothingMs             = 50

# --- how hard a hit has to be to skip the smoothing ---------------------------
#
# A fraction of full force, 0 to 1. Any jump bigger than this goes straight to
# the wheel unsmoothed, so crashes and big landings keep their punch even when
# smoothing is high. This is what stops CALM turning every impact into a shove.
#
# Lower (0.4) = more things count as an impact, so more of the drive punches
# through and the tune feels sharper overall. Higher (0.8) = only the very
# biggest hits do. Set it to 1 and nothing bypasses; impacts get smoothed with
# everything else.
shaper.impulseBypass           = 0.6

# --- a ceiling on force -------------------------------------------------------
#
# 1.0 means the wheel may reach its full strength. Lower it if your base is
# simply too strong at full tilt and you would rather cap the peaks than turn
# everything down: 0.8 keeps all the detail of normal driving and only takes
# the top off crashes and off-road.
#
# Note SETTINGS > FORCE FEEDBACK > PEAK LIMIT does something related but
# earlier, on the game's own number before any of this. Use one or the other,
# not both, or you will not know which is doing the work.
shaper.peakLimit               = 1.0

# --- ignore the very smallest forces ------------------------------------------
#
# A fraction of full force below which the wheel is simply told nothing. 0 sends
# everything. Raise it a little (0.01) if the wheel hums or fidgets when you are
# sitting still on a menu; too high and you lose the fine road texture that
# makes the road surface feel like a surface.
shaper.deadzone                = 0

# --- how much has to change before we bother the wheel ------------------------
#
# The force is only re-sent when it moves by more than this fraction of full.
# Small values mean smoother, more continuous force but more traffic to the
# wheel. This is set to about 33 steps of 32767 - one step of the game's own
# resolution - so it never throws away anything the game actually said.
# Raise it (0.01) only if you suspect the wheel is being overwhelmed.
shaper.releveling              = 0.001007

# --- when to stop pushing altogether ------------------------------------------
#
# Once the game asks for zero, the force is released as soon as the smoothed
# value falls below this fraction of full. Without it a heavily smoothed tune
# would trail off forever and leave a faint push on a straight road. Raise it if
# the wheel feels like it never quite lets go; lower it if force seems to vanish
# a touch early coming out of a corner.
shaper.settleBelow             = 0.004883

# --- overall level ------------------------------------------------------------
#
# 50 means "exactly as tuned" - NOT 50 percent. 100 is twice as strong, 25 is
# half. Leave this alone unless you know you want it: SETTINGS > FORCE FEEDBACK
# > STRENGTH already scales the output and is far easier to change. Setting both
# multiplies them together, which is how people end up with a wheel that is
# either dead or trying to break their thumbs.
shaper.strength                = 50

# --- direction ----------------------------------------------------------------
#
# Leave false. Cruis'n handles wheel direction in the emulator, and SETTINGS >
# FORCE FEEDBACK > DIRECTION is the switch for a base that is wired the other
# way round. Setting this as well would flip it back again.
shaper.invert                  = false


# =============================================================================
# A SECOND TUNE TO COMPARE AGAINST
# =============================================================================
# Delete the leading # from these four lines and you have a second entry in the
# FEEL row, so you can flip between two of your own tunes rather than against a
# shipped one. Keep them one change apart or the comparison tells you nothing.
#
# [cruisn-vunit@51]
# description = my tune, sharper
# inherits = cruisn-vunit@50
# shaper.smoothingMs             = 25
#
#
# Numbering: stick to 50 and up. The shipped tunes will grow past @4 one day,
# and if your number collides with theirs yours wins and you will wonder why a
# new tune never appeared.
#
# One rule worth keeping: once you have told someone "I liked @50", do not
# change @50 - add @51. Otherwise every note either of you wrote about how it
# drove is quietly describing a tune that no longer exists.
